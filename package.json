{
  "name": "orbital-reliability-lab",
  "version": "0.2.0",
  "private": true,
  "description": "A systems reliability, automation, and operations engineering lab for high-consequence factory and mission environments.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/engine.test.js",
