{
  "name": "orbital-reliability-lab",
  "version": "0.6.0",
  "private": true,
  "description": "A dual-domain reliability and operations engineering lab with mission network failover, factory production, MQTT, and OPC-UA simulations.",
  "type": "module",
  "scripts": {
    "start": "node src/server.js",
    "dev": "node --watch src/server.js",
    "test": "node --test tests/engine.test.js tests/mission-network-model.test.js tests/production-model.test.js tests/industrial-communications-model.test.js",
    "smoke": "node scripts/smoke-test.mjs",
    "test:e2e": "playwright test",
    "test:api": "playwright test tests/api.spec.js",
    "test:ui": "playwright test tests/dashboard.spec.js"
  },
  "engines": { "node": ">=20" },
  "devDependencies": { "@playwright/test": "^1.54.2" }
}
